{
  "name": "routex",
  "version": "4.5.0",
  "description": "RouteX",
  "author": "Jarv1s0",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:ci": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "typecheck:node": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "typecheck": "run-p typecheck:*",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check:ipc-contract": "node scripts/check-ipc-contract.mjs",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "check:release-env": "node scripts/check-release-env.mjs",
    "audit:node": "node scripts/check-node-audit.mjs",
    "audit:rust": "node scripts/check-rust-audit.mjs",
    "prepare:resources": "node scripts/prepare.mjs",
    "start": "vite preview --configLoader runner --config vite.tauri.config.ts",
    "dev": "tauri dev --no-watch",
    "dev:tauri-web": "vite --configLoader runner --config vite.tauri.config.ts",
    "build:tauri-web": "vite build --configLoader runner --config vite.tauri.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --no-watch",
    "tauri:build": "tauri build",
    "build": "pnpm run prepare:resources && pnpm run check:release-env && pnpm run typecheck && tauri build",
    "test:web": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "verify": "pnpm run lint:ci && pnpm run typecheck && pnpm run clippy && pnpm run check:ipc-contract && pnpm run check:dead-code && pnpm run test:web && pnpm run audit:node && pnpm run audit:rust && pnpm run test:rust && pnpm run build:tauri-web",
    "analyze": "cross-env ANALYZE=true pnpm run build:tauri-web",
    "build:win": "pnpm run build",
    "build:mac": "pnpm run build",
    "build:linux": "pnpm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "dayjs": "^1.11.23",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^9.39.5",
    "@heroui/react": "2.8.10",
    "@hookform/resolvers": "^7.0.7",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "9.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/spark-md5": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "cross-env": "^10.1.0",
    "dagre": "^0.8.5",
    "echarts": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "framer-motion": "^14.6.0",
    "is-cidr": "^7.0.3",
    "is-ip": "^5.0.1",
    "jsdom": "^31.0.1",
    "meta-json-schema": "1.19.33",
    "next-themes": "^0.4.6",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
