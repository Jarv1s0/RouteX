    "rollup-plugin-visualizer": "^7.1.1",
    "sonner": "^2.0.8",
    "spark-md5": "^3.0.2",
    "swr": "^2.5.1",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "tauri-cli"
    ],
    "overrides": {
      "@babel/core": "^7.29.7",
      "@humanfs/node": "0.16.8",
      "baseline-browser-mapping": ">=2.11.0",
      "browserslist": ">=4.28.7",
      "follow-redirects": "^1.16.0",
      "qs": ">=6.14.2",
      "tar": "^7.5.18",
      "flatted": "^3.4.2",
      "yauzl": "^3.2.1",
      "@tootallnate/once": ">=3.0.1",
      "fast-xml-parser": "^5.5.7",
      "@isaacs/brace-expansion": "^5.0.1",
      "brace-expansion": "^5.0.12",
      "shell-quote": "^1.11.0",
      "source-map-js": "^1.2.2",
      "picomatch": "^4.0.4",
      "rollup": ">=4.59.0",
      "minimatch": "^11.0.1",
      "path-to-regexp": ">=8.4.0",
      "@xmldom/xmldom": "0.8.12",
      "postcss": "8.5.23",
      "esbuild": "0.28.1"
    }
  },
  "packageManager": "pnpm@10.15.0"
}
